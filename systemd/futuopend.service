[Unit]
Description=FutuOpenD - Futu API gateway daemon
Documentation=https://openapi.futunn.com/futu-api-doc/opend/opend-cmd.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/util/Futu_OpenD_10.9.6918_Ubuntu18.04/Futu_OpenD_10.9.6918_Ubuntu18.04
EnvironmentFile=%h/Projects/FutuBot/.env
# Credentials and listen settings live in the config file (generated by
# install.sh from .env, chmod 600) so they never appear in the process
# command line / ps output.
# -console=0       run in background (no interactive console)
# -no_monitor=1    do not spawn FutuOpenD's own guardian process;
#                  systemd handles supervision/restart instead
ExecStart=%h/util/Futu_OpenD_10.9.6918_Ubuntu18.04/Futu_OpenD_10.9.6918_Ubuntu18.04/FutuOpenD \
    -cfg_file=%h/.config/futuopend/FutuOpenD.xml \
    -login_region=${FUTU_LOGIN_REGION} \
    -console=0 \
    -no_monitor=1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
